# Copy to .env and fill in. Free key: https://fdc.nal.usda.gov/api-key-signup
# Dev only: EXPO_PUBLIC_* is bundled into the client. Move USDA behind the backend before release.
EXPO_PUBLIC_USDA_API_KEY=

# Backend (Render). Defaults to https://fitnesschef.onrender.com if left empty.
EXPO_PUBLIC_API_URL=
# Must match the APP_KEY env var set on the Render service. Leave empty if APP_KEY is not set there.
# Bundled into the client, so it only deters casual abuse; it is not a real paywall.
EXPO_PUBLIC_APP_KEY=
